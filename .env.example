# Storefront (Vite) configuration. Copy to `.env` for local overrides; `.env` is git-ignored.
# Only VITE_* values are exposed to the browser — never put secrets here. The database
# credentials and signing secrets live in server/.env and never reach the frontend.

# Base URL of the LLX API (server/). No trailing slash, no /api suffix.
#   - Local dev: leave unset; it defaults to http://localhost:4000.
#   - Production: leave unset to use the live API, https://api.leatherluxindia.com (src/lib/api.ts),
#     or set it to another API's public https URL.
# Set it to an EMPTY value (VITE_API_URL=) for a build with no server: the storefront then runs in
# guest mode (bag and wishlist stay in the browser's localStorage and accounts are disabled).
VITE_API_URL=
