# Storefront (Vite) configuration. Copy to `.env` for local overrides; `.env` is git-ignored.
# Only VITE_* values are exposed to the browser — never put secrets here. The database
# credentials and signing secrets live in server/.env (locally) or in Vercel's Environment Variables
# (in production) and never reach the browser.

# Where the API (server/) is. No trailing slash, no /api suffix.
#   - Leave it unset (or empty):
#       local development uses the API at http://localhost:4000 (npm run dev in server/);
#       a production build uses THIS site's own /api: the API runs inside the same Vercel deployment (src/lib/api.ts).
#   - A URL (https://api.example.com) points the site at a separate API instead.
#   - `off` builds a site with no server at all: guest mode (bag and wishlist stay in the browser's
#     localStorage, the built-in catalogue is used, accounts are disabled).
VITE_API_URL=
