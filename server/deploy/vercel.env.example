# Environment Variables for the Vercel project (Settings -> Environment Variables). Add every line below as its own variable, for BOTH
# "Production" and "Preview", and mark the secrets "Sensitive". Replace every REPLACE_ME. This file holds placeholders only: real
# values are typed into Vercel and never committed. No inline comments after a value (comments stay on their own lines).

NODE_ENV=production
LOG_LEVEL=info
# Vercel's disk is read-only and keeps the logs itself (Vercel -> Logs).
LOG_TO_FILES=false
# One proxy (Vercel's) sits in front, so the real client address comes from X-Forwarded-For. (On Vercel the API never uses less than 1, even if
# this line is missing or says 0; without it every visitor would share one address and one rate-limit counter.)
TRUST_PROXY=1

CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_STALE_SECONDS=300
AUTH_CACHE_SECONDS=5

# The database (your EC2 Postgres). Get the three DB_SSL_ lines by running `npm run db:ca` in server/ on your computer: with them the API
# accepts only the database's own certificate, so nobody between Vercel and the database can pretend to be it.
DB_HOST=REPLACE_ME
DB_PORT=5432
DB_NAME=LLI
DB_USER=llx_app
DB_PASSWORD=REPLACE_ME
DB_SSL_MODE=verify-full
DB_SSL_SERVERNAME=REPLACE_ME
DB_SSL_CA=REPLACE_ME
# Every serverless instance has its own small pool. Keep it tiny so many instances at once cannot use up Postgres's connections.
DB_POOL_MAX=3
DB_POOL_IDLE_MS=10000
DB_CONNECT_TIMEOUT_MS=8000
DB_STATEMENT_TIMEOUT_MS=8000

# IMPORTANT: copy BOTH secrets from the server/.env you use today, do not generate new ones.
# A different PASSWORD_PEPPER means nobody can sign in any more (every stored password hash depends on it).
JWT_ACCESS_SECRET=REPLACE_ME
PASSWORD_PEPPER=REPLACE_ME

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# The API is on the same domain as the site, so cookies are host-only (no COOKIE_DOMAIN) and lax works on every domain the site is served from.
# CORS_ORIGINS must list the exact origin of every address the site is served on (no path, no trailing slash, all https).
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://leatherluxindia.com,https://www.leatherluxindia.com,https://leatherluxindia.in,https://www.leatherluxindia.in,https://leatherluxindia.vercel.app

# Request counters shared by every instance (a limit held per instance would be trivially dodged). Needs migration 006.
RATE_LIMIT_STORE=postgres
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_NEWSLETTER_PER_HOUR=10

# The visit log (every page view with the visitor's IP address, see docs/visit-log.md) is deleted after this many days. 0 keeps it for ever.
VISIT_LOG_RETENTION_DAYS=365

# Orders stay closed until launch. On launch day change this to true and redeploy.
ORDERS_OPEN=false

SHIPPING_FREE_THRESHOLD_INR=2500
SHIPPING_FLAT_INR=150
