# Production settings for the LLX API on the server. Copy to /opt/llx/server/.env, fill in every REPLACE_ME, then: chmod 600 .env
# No inline comments after a value (keep comments on their own lines). Never commit the filled-in file.

NODE_ENV=production
PORT=4000
# Listen on the loopback only: nginx is the public door (deploy/nginx-api.conf).
HOST=127.0.0.1
# One proxy (nginx) sits in front, so the real client IP comes from X-Forwarded-For.
TRUST_PROXY=1

LOG_LEVEL=info
LOG_TO_FILES=true
LOG_DIR=logs
LOG_RETENTION_DAYS=30
LOG_TIMEZONE=Asia/Kolkata

# Product photos (copy server/media/ here from your computer; see deploy/README.md).
MEDIA_DIR=media

CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
CACHE_STALE_SECONDS=300
AUTH_CACHE_SECONDS=5

# Database. API and Postgres on the same server: DB_HOST=127.0.0.1. Production refuses DB_SSL_MODE=disable.
# verify-full with DB_SSL_CA_PATH (and DB_SSL_SERVERNAME when DB_HOST is an IP address) is the strictest choice.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=LLI
DB_USER=llx_app
DB_PASSWORD=REPLACE_ME
DB_SSL_MODE=require
DB_SSL_CA_PATH=
DB_SSL_SERVERNAME=
DB_POOL_MAX=10

# IMPORTANT: copy BOTH secrets from the .env you use today, do not generate new ones.
# A different PASSWORD_PEPPER means nobody can sign in any more (every stored password hash depends on it).
JWT_ACCESS_SECRET=REPLACE_ME
PASSWORD_PEPPER=REPLACE_ME

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# The shop runs on https://leatherluxindia.com and the API on https://api.leatherluxindia.com: the same site, so lax cookies work.
# Cookies are always Secure in production. CORS_ORIGINS must list the exact origin of every page that calls the API.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=.leatherluxindia.com
CORS_ORIGINS=https://leatherluxindia.com

RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_NEWSLETTER_PER_HOUR=10

# Orders stay closed until launch: shoppers can browse and fill a bag, but placing an order is refused.
# On launch day change this to true and restart the API (sudo systemctl restart llx-api).
ORDERS_OPEN=false

SHIPPING_FREE_THRESHOLD_INR=2500
SHIPPING_FLAT_INR=150
