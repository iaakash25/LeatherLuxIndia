# ─────────────────────────────────────────────────────────────────────────────
# LLX API — environment configuration
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and must
# never be committed. In production prefer injecting these as real environment
# variables (systemd EnvironmentFile, AWS SSM Parameter Store / Secrets Manager).
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | production | test
PORT=4000
HOST=0.0.0.0
# Number of reverse-proxy hops in front of the API (nginx / ALB = 1, none = 0).
# Required for correct client IPs in rate limiting. Never set higher than reality.
TRUST_PROXY=0
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace

# Daily log files, one set per day, named by date:
#   logs/app-2026-11-01.log     everything (requests, warnings, errors)
#   logs/error-2026-11-01.log   errors only
LOG_TO_FILES=true
LOG_DIR=logs                    # relative to server/, or an absolute path
LOG_RETENTION_DAYS=30           # older files are deleted automatically; 0 keeps everything
LOG_TIMEZONE=Asia/Kolkata       # decides when "a day" starts, and the time shown on each line

# Product photos (made by `npm run products:import`) are served from this folder at /media.
MEDIA_DIR=media
# Where the original DSLR photos live, for the importer only:
# PRODUCT_PHOTOS_DIR=D:\Leather Lux India\DSLR Images\New Products

# In-memory caching, so pages don't query Postgres on every view.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60            # catalogue and branding are served from memory this long
CACHE_STALE_SECONDS=300         # after that, an old copy may still be served while a fresh one loads
AUTH_CACHE_SECONDS=5            # who a login cookie belongs to; keep short (0 = look up every time)

# ── EC2 PostgreSQL instance ──────────────────────────────────────────────────
# Use the instance's PRIVATE IP / private DNS when the API runs in the same VPC.
# If you must use the public address, restrict the security group's 5432 rule to
# the API server's IP only — never 0.0.0.0/0.
DB_HOST=ec2-xx-xx-xx-xx.compute-1.amazonaws.com
DB_PORT=5432
DB_NAME=llx
DB_USER=llx_app
DB_PASSWORD=change-me

# TLS to the database:
#   disable      – no TLS (refused when NODE_ENV=production)
#   require      – encrypted, but the server certificate is NOT verified
#   verify-full  – encrypted + certificate and hostname verified (recommended)
DB_SSL_MODE=require
# Path to the CA certificate (PEM) that signed the server certificate. Needed for
# verify-full with a self-signed / private CA (the usual EC2 setup).
DB_SSL_CA_PATH=
# Only if the hostname you connect to differs from the certificate's CN/SAN.
DB_SSL_SERVERNAME=

DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000

# ── Secrets (generate each with: npm run gen:secret) ─────────────────────────
# Signs access tokens (JWT, HS256). Minimum 32 characters. Rotating it logs
# everyone out.
JWT_ACCESS_SECRET=
# Mixed into password hashes (HMAC) so a stolen DB dump is useless without it.
# Minimum 32 characters. If you lose or change it, every password stops working.
PASSWORD_PEPPER=

# ── Sessions & cookies ───────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Secure cookies (HTTPS only). Forced on in production.
COOKIE_SECURE=false
# lax | strict | none. Use `none` (requires HTTPS) only if the frontend and API are
# on different sites, e.g. app on *.lovable.app and API on your own domain.
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com to share cookies between app.example.com and api.example.com.
COOKIE_DOMAIN=

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
# Comma-separated list of exact frontend origins allowed to call the API with
# credentials. No wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:3000

# ── Rate limiting (per client IP) ────────────────────────────────────────────
RATE_LIMIT_GLOBAL_PER_MIN=300
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_NEWSLETTER_PER_HOUR=10

# ── Shop rules (INR, whole rupees) ───────────────────────────────────────────
# Placing orders. false = shoppers can browse and fill a bag, but orders are refused (before launch). Set true on launch day, then restart the API.
ORDERS_OPEN=true

SHIPPING_FREE_THRESHOLD_INR=2500
SHIPPING_FLAT_INR=150
